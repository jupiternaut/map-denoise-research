{
  "title": "V24：等位移预算下的表面距离变化",
  "subtitle": "三种修正场的排序依场景而变；距离改善需同时查看覆盖代价。",
  "source": {
    "label": "V24 / 42 exposed patches / frozen output evaluation",
    "path": "/srv/slam-research/grf/map-denoise/runs/field-budget-v24-uvg3jss3/RESULTS.json",
    "query": {
      "engine": "SQLite (in memory)",
      "language": "sql",
      "sql": "\nSELECT a.scene, a.field, COUNT(*) AS n_patches,\n       AVG(a.accuracy_mm) AS accuracy_mm,\n       AVG(i.accuracy_mm - a.accuracy_mm) AS mae_gain_mm,\n       AVG(a.recall) * 100.0 AS recall_percent,\n       AVG(a.recall - i.recall) * 100.0 AS recall_change_pp,\n       AVG(a.actual_budget_mm) AS actual_budget_mm\nFROM v24_results AS a\nJOIN v24_results AS i ON a.case_id=i.case_id AND i.method='native__identity'\nWHERE a.kind='budget' AND a.allocation='uniform'\n  AND a.requested_budget_mm=0.025\nGROUP BY a.scene,a.field\nORDER BY a.scene,a.field\n",
      "description": "同片输入与输出距离差，按场景及修正场等权平均；0.025 mm预算未触发上限。",
      "tables_used": [
        "v24_results"
      ],
      "metric_definitions": {
        "mae_gain_mm": "mean_patch(identity MAE - candidate MAE), positive=lower error; mm",
        "recall_change_pp": "mean_patch(candidate recall - identity recall)*100; percentage points"
      }
    }
  },
